APP_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=storageviewr
REGISTRATION_ENABLED=true
# Sätt till 1 endast under riktad prestandamätning. Loggar tider men inga tenant-id:n.
PERFORMANCE_LOGGING=0

# Central felrapportering. DSN ar offentlig men auth-token far endast finnas i
# byggmiljon. Lamna falten tomma for att stanga av Sentry lokalt.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_RELEASE=
